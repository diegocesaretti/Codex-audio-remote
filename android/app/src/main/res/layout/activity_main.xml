<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Codex Audio Remote"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Wake local: “hola sol”" />

        <EditText
            android:id="@+id/serverIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="IP de la PC"
            android:inputType="textUri"
            android:text="192.168.1.100" />

        <EditText
            android:id="@+id/serverPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Puerto"
            android:inputType="number"
            android:text="8765" />

        <TextView
            android:id="@+id/sensitivityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Sensibilidad wake: 60%" />

        <SeekBar
            android:id="@+id/sensitivitySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="60" />

        <TextView
            android:id="@+id/qualityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Calidad: 80% · Alta · 48 kHz" />

        <SeekBar
            android:id="@+id/qualitySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calidad controla el sample rate: 16 / 24 / 48 kHz. 48 kHz cae automáticamente a 16 kHz si el dispositivo no lo soporta." />

        <TextView
            android:id="@+id/latencyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Latencia automática: 55% · Equilibrada · paquetes ~50 ms" />

        <SeekBar
            android:id="@+id/latencySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="55" />

        <CheckBox
            android:id="@+id/manualLatencyCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usar latencia manual" />

        <EditText
            android:id="@+id/manualChunkMs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tamaño de paquete manual en ms"
            android:inputType="number"
            android:text="45" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo manual recomendado: 45 ms. Rango permitido: 20–120 ms. Si está activo, reemplaza al slider de latencia para el uplink." />

        <Button
            android:id="@+id/audioTestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Test mic local · grabar 5 s y escuchar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este test usa la misma captura VOICE_RECOGNITION y el mismo sample rate, pero no usa Wi‑Fi, Windows ni VB-CABLE. Sirve para aislar problemas de calidad del micrófono." />

        <EditText
            android:id="@+id/timeoutSeconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Timeout conversación en segundos (0 = sin límite)"
            android:inputType="number"
            android:text="300" />

        <EditText
            android:id="@+id/endPhrases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Frases de finalización separadas por coma"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:text="gracias sol, chau sol, adiós sol, listo sol" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Las frases se reconocen localmente durante la conversación y cierran Voice sin esperar el timeout." />

        <CheckBox
            android:id="@+id/autostartCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Iniciar satélite al encender Android" />

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permitir overlay sobre Home Assistant" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Conectar / iniciar servicio" />

        <Button
            android:id="@+id/wakeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Probar wake" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Inactivo"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="La primera vez descarga el modelo español de Vosk (~39 MB). Luego wake y frases de finalización funcionan localmente, incluso con Home Assistant en primer plano." />
    </LinearLayout>
</ScrollView>
