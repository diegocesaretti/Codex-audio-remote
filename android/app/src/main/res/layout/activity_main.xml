<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Codex Audio Remote v2"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Windows manda el estado; Android aplica una sola política de audio." />

        <com.bwa3d.codexremote.RuntimeStatusPanel
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Servidor" android:textStyle="bold" />
        <EditText android:id="@+id/serverIp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="IP de la PC" android:inputType="textUri" android:text="192.168.1.100" />
        <EditText android:id="@+id/serverPort" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Puerto" android:inputType="number" android:text="8765" />
        <Button android:id="@+id/connectButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conectar / iniciar servicio" />
        <Button android:id="@+id/wakeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Probar wake" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Wake word" android:textStyle="bold" />
        <com.bwa3d.codexremote.WakeWordEditText
            android:id="@+id/wakeWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej.: hola sol"
            android:inputType="text"
            android:maxLines="1" />
        <TextView android:id="@+id/sensitivityText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sensibilidad wake: 60%" />
        <SeekBar android:id="@+id/sensitivitySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="60" />
        <com.bwa3d.codexremote.WakeScreenCheckBox android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Encender pantalla al detectar wake word" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Wake GIF fullscreen" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Opcional: al detectar la wake word muestra un GIF local sobre toda la pantalla, con fondo configurable y transición suave." />
        <com.bwa3d.codexremote.WakeGifSettingsView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Micrófono de conversación" android:textStyle="bold" />
        <TextView android:id="@+id/qualityText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calidad: 80% · Alta · 48 kHz" />
        <SeekBar android:id="@+id/qualitySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="80" />
        <TextView android:id="@+id/micGainText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ganancia mic: 100% · 1.00×" />
        <SeekBar android:id="@+id/micGainSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="350" android:progress="50" />
        <Spinner android:id="@+id/audioSourceSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/audioSourceHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="En Android 6, Default Android suele ser la captura más estable." />
        <Spinner android:id="@+id/voiceEnhancerSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/noiseSuppressorCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Noise Suppressor Android" />
        <CheckBox android:id="@+id/androidAgcCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AGC Android" />
        <CheckBox android:id="@+id/aecCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AEC Android" />

        <TextView android:id="@+id/latencyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Latencia automática: 55%" />
        <SeekBar android:id="@+id/latencySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="55" />
        <CheckBox android:id="@+id/manualLatencyCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Usar latencia manual" />
        <EditText android:id="@+id/manualChunkMs" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Paquete manual (ms)" android:inputType="number" android:text="45" />
        <Button android:id="@+id/audioTestButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Test mic local · grabar 5 s y escuchar" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Fin / reanudación de conversación" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="En Realtime, Windows controla dos tiempos separados: fin de escucha (cierra sólo el mic) y fin de conversación. Mientras está en espera, decir la wake word reabre el mic en la misma conversación." />
        <EditText android:id="@+id/timeoutSeconds" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Timeout legacy" android:inputType="number" android:text="300" android:visibility="gone" />
        <com.bwa3d.codexremote.PersistentEndPhrasesEditText
            android:id="@+id/endPhrases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Frases que cierran el micrófono y dejan la conversación en espera, separadas por coma"
            android:maxLines="3" />
        <com.bwa3d.codexremote.EndSensitivityControl android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Sonidos de estado" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cuatro sonidos locales: wake, uplink listo, fin de escucha y fin de conversación. Cada uno puede usar el chime interno o un audio descargado." />
        <com.bwa3d.codexremote.AudioCueSettingsView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Overlay" android:textStyle="bold" />
        <com.bwa3d.codexremote.PreferenceCheckBox
            android:id="@+id/transcriptCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mostrar transcripción local de la respuesta" />
        <com.bwa3d.codexremote.OverlaySizeSeekBar android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.bwa3d.codexremote.OverlayColorSpinner android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/overlayButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Permitir overlay sobre otras apps" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Servicio" android:textStyle="bold" />
        <com.bwa3d.codexremote.StartOnOpenCheckBox
            android:id="@+id/startOnOpenCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar servicio al abrir la app" />
        <CheckBox android:id="@+id/autostartCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Iniciar satélite al encender Android" />

        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Listo" android:textSize="16sp" />
        <TextView android:id="@+id/helpText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="El estado de PC y de audio de arriba proviene directamente del stack v2." />
    </LinearLayout>
</ScrollView>
