<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Codex Audio Remote"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Wake local: “hola sol”" />

        <EditText
            android:id="@+id/serverIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="IP de la PC"
            android:inputType="textUri"
            android:text="192.168.1.100" />

        <EditText
            android:id="@+id/serverPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Puerto"
            android:inputType="number"
            android:text="8765" />

        <TextView
            android:id="@+id/sensitivityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Sensibilidad wake: 60%" />

        <SeekBar
            android:id="@+id/sensitivitySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="60" />

        <CheckBox
            android:id="@+id/autostartCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar satélite al encender Android" />

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permitir overlay sobre Home Assistant" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Conectar / iniciar servicio" />

        <Button
            android:id="@+id/wakeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Probar wake" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Inactivo"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="La primera vez descarga el modelo español de Vosk (~39 MB). Luego el wake word funciona localmente y el servicio puede quedar en segundo plano mientras Home Assistant permanece visible." />
    </LinearLayout>
</ScrollView>
