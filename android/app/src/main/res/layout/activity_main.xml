<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Codex Audio Remote" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Wake local configurable con Vosk" />

        <EditText android:id="@+id/serverIp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:hint="IP de la PC" android:inputType="textUri" android:text="192.168.1.100" />
        <EditText android:id="@+id/serverPort" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Puerto" android:inputType="number" android:text="8765" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Wake word" />
        <com.bwa3d.codexremote.WakeWordEditText
            android:id="@+id/wakeWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej.: hola sol"
            android:inputType="text"
            android:maxLines="1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Se guarda automáticamente y el detector local se recarga al cambiarla." />

        <TextView android:id="@+id/sensitivityText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Sensibilidad wake: 60%" />
        <SeekBar android:id="@+id/sensitivitySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="60" />
        <com.bwa3d.codexremote.WakeScreenCheckBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Encender pantalla al detectar wake word" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="En Android 6 usa un wake-lock corto para despertar la pantalla al detectar la palabra de activación." />

        <TextView android:id="@+id/qualityText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Calidad: 80% · Alta · 48 kHz" />
        <SeekBar android:id="@+id/qualitySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="80" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calidad controla el sample rate: 16 / 24 / 48 kHz. 48 kHz cae automáticamente a 16 kHz si el dispositivo no lo soporta." />

        <TextView android:id="@+id/micGainText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Ganancia mic: 100% · 1.00×" />
        <SeekBar android:id="@+id/micGainSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="350" android:progress="50" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ganancia digital 50–400%. 100% no modifica el audio. El Voice Enhancer limita picos si está activo." />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Modo de captura del micrófono" />
        <Spinner android:id="@+id/audioSourceSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/audioSourceHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reconocimiento de voz suele ser el modo más limpio para asistentes. Llamada puede aplicar procesamiento agresivo según el fabricante." />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Voice Enhancer" />
        <Spinner android:id="@+id/voiceEnhancerSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DSP propio: filtro de graves/DC + compresor + AGC suave + limiter. Normal es el punto de partida recomendado." />

        <CheckBox android:id="@+id/noiseSuppressorCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Noise Suppressor de Android (experimental)" />
        <CheckBox android:id="@+id/androidAgcCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AGC de Android (experimental)" />
        <CheckBox android:id="@+id/aecCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cancelación de eco AEC de Android (experimental)" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Los tres efectos Android dependen del fabricante. Se dejan apagados por defecto y pueden empeorar la voz en algunos equipos." />

        <TextView android:id="@+id/latencyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Latencia automática: 55% · Equilibrada · paquetes ~50 ms" />
        <SeekBar android:id="@+id/latencySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="55" />

        <CheckBox android:id="@+id/manualLatencyCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Usar latencia manual" />
        <EditText android:id="@+id/manualChunkMs" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tamaño de paquete manual en ms" android:inputType="number" android:text="45" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modo manual recomendado: 45 ms. Rango permitido: 20–120 ms. Si está activo, reemplaza al slider de latencia para el uplink." />

        <Button android:id="@+id/audioTestButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Test mic local · grabar 5 s y escuchar" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="El test usa sample rate, fuente, ganancia, Voice Enhancer y efectos Android seleccionados, sin Wi‑Fi, Windows ni VB-CABLE." />

        <EditText android:id="@+id/timeoutSeconds" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Timeout conversación en segundos (0 = sin límite)" android:inputType="number" android:text="300" />
        <com.bwa3d.codexremote.PersistentEndPhrasesEditText
            android:id="@+id/endPhrases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Frases de finalización separadas por coma"
            android:inputType="textCapSentences"
            android:maxLines="3" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Las frases se guardan mientras las editás y se reconocen localmente durante la conversación." />
        <com.bwa3d.codexremote.EndSensitivityControl
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0% = casi coincidencia perfecta (99% de confianza). 100% = mucho más tolerante. Si tenés falsos cierres, bajalo." />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Overlay" android:textStyle="bold" />
        <com.bwa3d.codexremote.PreferenceCheckBox
            android:id="@+id/transcriptCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mostrar transcripción local de la respuesta de Sol" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="La transcripción se actualiza dentro del popup sin relanzarlo." />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tamaño del overlay (80–170%)" />
        <com.bwa3d.codexremote.OverlaySizeSeekBar
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Color del overlay" />
        <com.bwa3d.codexremote.OverlayColorSpinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Los cambios de tamaño/color se aplican en la próxima conversación para mantener el popup estable durante la charla." />

        <com.bwa3d.codexremote.StartOnOpenCheckBox
            android:id="@+id/startOnOpenCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Iniciar servicio al abrir la app" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Si está activado, al abrir Codex Audio Remote inicia el satélite automáticamente usando la IP y puerto guardados." />

        <CheckBox android:id="@+id/autostartCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Iniciar satélite al encender Android" />
        <Button android:id="@+id/overlayButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Permitir overlay sobre Home Assistant" />
        <Button android:id="@+id/connectButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Conectar / iniciar servicio" />
        <Button android:id="@+id/wakeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Probar wake" />

        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Inactivo" android:textSize="17sp" />
        <TextView android:id="@+id/helpText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Wake, frases de finalización y transcripción opcional funcionan localmente con el modelo Vosk incluido." />
    </LinearLayout>
</ScrollView>
