<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Codex Audio Remote"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/serverIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="IP de la PC"
        android:inputType="textUri"
        android:text="192.168.1.100" />

    <EditText
        android:id="@+id/serverPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Puerto"
        android:inputType="number"
        android:text="8765" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Conectar / iniciar servicio" />

    <Button
        android:id="@+id/wakeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Probar wake" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Inactivo"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/helpText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="El servicio sigue ejecutándose aunque vuelvas al dashboard de Home Assistant. El wake manual sirve para validar PC ↔ Android antes de agregar el modelo Vosk." />
</LinearLayout>
