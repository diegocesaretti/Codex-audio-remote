{
  "schemaVersion": 2,
  "id": "codex-audio-remote",
  "name": "Codex Audio Remote",
  "version": "1.4.1",
  "description": "Native SOL voice bridge using Codex Realtime V3/WebRTC, canonical SOL Persons and dynamic SOL plugin tools. The SOL package contains no virtual-cable, loopback, Bluetooth/btcom or HA audio-mirror runtime.",
  "runtime": "executable",
  "entry": "CodexAudioRemote.Server.exe",
  "args": [],
  "autoStart": true,
  "restartPolicy": "on-failure",
  "capabilities": [
    "audio.realtime",
    "codex.oauth",
    "homeassistant.context-consumer",
    "consumer.sol-plugin-tools",
    "voice.android-client",
    "input.codex-audio",
    "mcp.codex-audio",
    "identity.speaker-binding"
  ],
  "requires": [
    "plugin-api.v1",
    "input.register",
    "input.write",
    "input.status",
    "identity.read",
    "mcp.register",
    "mcp.invoke.read",
    "filesystem.plugin-data"
  ],
  "permissions": [
    "network.local",
    "windows.registry",
    "process.codex",
    "input.register",
    "input.write",
    "input.status",
    "identity.read",
    "mcp.register",
    "mcp.invoke.read",
    "mcp.invoke.actions",
    "filesystem.plugin-data"
  ],
  "settings": [
    {
      "key": "realtime_voice",
      "label": "Voz Realtime",
      "type": "select",
      "description": "Voz usada por Codex Realtime V3. El modelo Realtime se mantiene aislado del perfil de texto de SOL/Nexo.",
      "default": "sol",
      "options": [
        { "value": "alloy", "label": "Alloy" },
        { "value": "arbor", "label": "Arbor" },
        { "value": "ash", "label": "Ash" },
        { "value": "ballad", "label": "Ballad" },
        { "value": "breeze", "label": "Breeze" },
        { "value": "cedar", "label": "Cedar" },
        { "value": "coral", "label": "Coral" },
        { "value": "cove", "label": "Cove" },
        { "value": "echo", "label": "Echo" },
        { "value": "ember", "label": "Ember" },
        { "value": "juniper", "label": "Juniper" },
        { "value": "maple", "label": "Maple" },
        { "value": "marin", "label": "Marin" },
        { "value": "sage", "label": "Sage" },
        { "value": "shimmer", "label": "Shimmer" },
        { "value": "sol", "label": "Sol" },
        { "value": "spruce", "label": "Spruce" },
        { "value": "vale", "label": "Vale" },
        { "value": "verse", "label": "Verse" }
      ]
    },
    {
      "key": "voice_style",
      "label": "Estilo de voz",
      "type": "select",
      "description": "Instrucción nativa de Realtime aplicada al iniciar cada sesión. No inyecta audio ni agrega un turno oculto.",
      "default": "flirty",
      "options": [
        { "value": "stable", "label": "Estable" },
        { "value": "warm", "label": "Cálido" },
        { "value": "flirty", "label": "Flirty sutil" },
        { "value": "expressive", "label": "Expresivo" },
        { "value": "custom", "label": "Personalizado" },
        { "value": "off", "label": "Desactivado" }
      ]
    },
    {
      "key": "voice_style_custom_prompt",
      "label": "Prompt de estilo personalizado",
      "type": "text",
      "description": "Se usa sólo con Estilo de voz = Personalizado. Máximo efectivo: 240 caracteres."
    },
    {
      "key": "realtime_working_directory",
      "label": "Carpeta de trabajo Realtime",
      "type": "path",
      "description": "Proyecto/carpeta que recibe las conversaciones. Vacío conserva la configuración persistida."
    },
    {
      "key": "ingest_transcripts",
      "label": "Guardar transcripciones en SOL",
      "type": "boolean",
      "description": "Ingiere únicamente transcripciones finales. Si el hablante está vinculado, agrega un personEntityId canónico validado por SOL como metadata.",
      "default": true
    }
  ],
  "distribution": {
    "type": "github-release",
    "tag": "sol-plugin-latest",
    "asset": "CodexAudioRemote.solplugin"
  }
}
